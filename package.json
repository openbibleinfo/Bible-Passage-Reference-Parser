{
  "name": "bible-passage-reference-parser",
  "version": "4.0.0-alpha",
  "description": "Identifies and parses Bible references (like John 3:16) in over 40 languages.",
  "main": "./esm/bcv_parser.js",
  "types": "./types/bcv_parser.d.ts",
  "directories": {
    "test": "test"
  },
  "files": [
    "cjs/",
    "js/",
    "esm/",
    "types/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./types/bcv_parser.d.ts",
      "default": "./esm/bcv_parser.js"
    },
    "./esm/bcv_parser.js": {
      "types": "./types/bcv_parser.d.ts",
      "default": "./esm/bcv_parser.js"
    },
    "./esm/lang/*.js": {
      "types": "./types/lang.d.ts",
      "default": "./esm/lang/*.js"
    },
    "./cjs/*.js": "./cjs/*.js"
  },
  "typesVersions": {
    "*": {
      "esm/bcv_parser.js": [
        "types/bcv_parser.d.ts"
      ],
      "esm/lang/*.js": [
        "types/lang.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/openbibleinfo/Bible-Passage-Reference-Parser.git"
  },
  "type": "module",
  "keywords": [
    "bible",
    "verses"
  ],
  "author": "OpenBible.info <openbibleinfo@gmail.com> (https://www.openbible.info/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/openbibleinfo/Bible-Passage-Reference-Parser/issues"
  },
  "homepage": "https://github.com/openbibleinfo/Bible-Passage-Reference-Parser",
  "scripts": {
    "build-language": "cd bin && sh build_lang.sh",
    "test": "npx jasmine test/*.spec.*"
  },
  "devDependencies": {
    "@pemistahl/grex": "^1.0.2",
    "esbuild": "^0.25.8",
    "jasmine": "^5.9.0",
    "peggy": "^5.0.5",
    "typescript": "^5.8.3"
  }
}
